---
import { getCollection, getEntry, render } from "astro:content";
import { slug as githubSlug } from "github-slugger";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getOntology, displayTag, normalizeTag } from "../../lib/ontology/index.ts";

export async function getStaticPaths() {
  const definedTags = await getCollection("tags");

  // Shared, publish-filtered ontology view (prod: published only; dev: all).
  // Real articles only — exclude series-description entries.
  const view = await getOntology();
  const articles = view.articles.filter((e) => !view.isDescription(e));

  // Group articles by normalized tag slug; remember a display label per slug.
  const bySlug = new Map<string, { label: string; posts: typeof articles }>();
  for (const post of articles) {
    for (const raw of post.data.tags ?? []) {
      const slug = normalizeTag(raw);
      if (!slug) continue;
      let bucket = bySlug.get(slug);
      if (!bucket) {
        bucket = { label: displayTag(raw), posts: [] };
        bySlug.set(slug, bucket);
      }
      if (!bucket.posts.includes(post)) bucket.posts.push(post);
    }
  }

  return [...bySlug.entries()].map(([slug, { label, posts }]) => {
    const tagDef = definedTags.find((t) => t.id === slug);
    return {
      params: { tag: slug },
      props: {
        tagId: tagDef?.id ?? githubSlug(label),
        label,
        posts: posts.map((p) => ({
          id: p.id,
          title: p.data.title ?? p.id,
        })),
      },
    };
  });
}

const { tagId, label, posts } = Astro.props;
const tagEntry = tagId ? await getEntry("tags", tagId) : undefined;
const Content = tagEntry ? (await render(tagEntry)).Content : undefined;
const heading = label ?? Astro.params.tag;
---

<BaseLayout title={heading}>
  <h1>{heading}</h1>
  {Content && <Content />}
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/writings/${post.id}`}>{post.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
