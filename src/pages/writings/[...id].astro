---
import { getCollection, getEntry, render } from 'astro:content';
import '../../styles/global.css'

export async function getStaticPaths() {
    // Build routes for every entry in dev; only published entries in production.
    const entries = await getCollection('writings', ({ data }) =>
        import.meta.env.PROD ? data.published : true,
    );
    return entries.map(entry => ({
    params: { id: entry.id },
  }));
}

const entry = await getEntry('writings', Astro.params.id!);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
const title = entry.data.title ?? entry.id.split('/').at(-1)!;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <h1>{title}</h1>
    <blockquote>{entry.data.description}</blockquote>
    <Content />
  </body>
</html>
