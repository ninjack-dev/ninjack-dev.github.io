---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
    // Build routes for every entry in dev; only published entries in production.
    const entries = await getCollection('writings', ({ data }) =>
        import.meta.env.PROD ? data.published : true,
    );
    return entries.map(entry => ({
    params: { id: entry.id },
  }));
}

const entry = await getEntry('writings', Astro.params.id!);
if (!entry) return Astro.redirect('/404');
const { Content } = await render(entry);
const title = entry.data.title ?? entry.id.split('/').at(-1)!;
---

<BaseLayout title={title} description={entry.data.description}>
  <main class="prose">
    <h1>{title}</h1>
    <blockquote>{entry.data.description}</blockquote>
    <Content />
  </main>
</BaseLayout>
