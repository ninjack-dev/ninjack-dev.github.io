---
import type { GetStaticPaths } from "astro";
import { getOntology } from "../../lib/ontology/index.ts";
import Article from "../../components/writings/Article.astro";
import Series from "../../components/writings/Series.astro";
import Category from "../../components/writings/Category.astro";
import Root from "../../components/writings/Root.astro";
import "../../styles/prose.css";

// One catch-all route serving the full hierarchical taxonomy (ADR 0003):
// - article paths render the article;
// - series node paths render an index (description + article list);
// - category node paths render an index (subcategories, series, loose articles);
// - the root path renders the top-level index.
export const getStaticPaths = (async () => {
  // Shared, publish-filtered ontology view (prod: published only; dev: all).
  const view = await getOntology();

  // One route per article.
  const articleRoutes = view.articles.map((entry) => ({
    params: { path: entry.id },
    props: { kind: "article" as const, id: entry.id },
  }));

  // One route per node (category or series). Emit only nodes that have at
  // least one published article in scope, so empty nodes don't 404-bait.
  const nodeRoutes = [...view.nodes.values()]
    .filter((node) => view.count(node.path) > 0)
    .map((node) => ({
      params: { path: node.path },
      props: { kind: node.kind, id: node.path },
    }));

  // Root index: top-level categories + root articles.
  const rootRoute = {
    params: { path: undefined },
    props: { kind: "root" as const, id: "" },
  };

  return [rootRoute, ...articleRoutes, ...nodeRoutes];
}) satisfies GetStaticPaths;

const props = Astro.props;

// Re-fetch the shared view for this render (page modules don't share
// getStaticPaths scope); getOntology is memoized, so this reuses the cache.
const view = await getOntology();
---

{props.kind === "root" && <Root view={view} />}
{props.kind === "article" && <Article entryId={props.id} view={view} />}
{props.kind === "series" && <Series nodeId={props.id} view={view} />}
{props.kind === "category" && <Category nodeId={props.id} view={view} />}
