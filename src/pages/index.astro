---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePic from '../components/AvatarProfilePic.astro';
import StatusBar from '../components/StatusBar/StatusBar.astro';

// TODO: 
// - Replace these with the hrefs to their content pages
// - Add scaffold for submenu entries for Writings categories/subcategories/series
const menuItems = ["Writings", "Projects", "About"];
---
<!-- Document-level rules must target the <body> rendered by BaseLayout, so
     they can't be scoped to this component. Bundled only on this page. -->
<style is:global>
  :root {
    --panel-gap: 4rem;
  }

  body {
    display: flex;
    align-items: center;
    min-height: 100vh;
  }
</style>

<style>
  .home-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--panel-gap);
    width: 100%;
    font-family: var(--font-mono);
  }

  .home-panel-placeholder {
    display: flex;
    flex-direction: column;
    width: fit-content;
    align-items: center;
  }

  .main-menu {
    display: flex;
    flex-direction: column;
    width: fit-content;
    justify-self: end;

    .main-menu-button {
      display: flex;
      flex-direction: row;
      align-items: baseline;
      white-space: nowrap;
      font-size: calc(100% + 2em);

      .main-menu-button-index {
        font-weight: 100;
        padding-right: 0.3em;
      }

      &:hover {
        .main-menu-button-label {
          text-decoration: underline var(--accent);
          text-decoration-thickness: 1.5px;
          text-underline-offset: 5px;
        }
      }
    }
  }

</style>

<BaseLayout title="ninjack.dev">
  <StatusBar />
  <div class="home-panels">
    <div class="main-menu">
      {menuItems.map((l, i) => {
        return <div class="main-menu-button">
          <span class="main-menu-button-index">[{i + 1}]</span>
          <span class="main-menu-button-label">{l}</span>
        </div>
      })}
    </div>
    <div class="home-panel-placeholder">
      <ProfilePic />
      <blockquote style="margin-top: 1em;">Jack of all trades, master of some</blockquote>
      <p>Software engineer based out of Portland, OR.<br>Lover of all things dev tooling.</p>
    </div>
  </div>
</BaseLayout>
