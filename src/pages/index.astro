---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePic from '../components/AvatarProfilePic.astro';
import StatusBar from '../components/StatusBar/StatusBar.astro';
import { buildOntology, type OntologyNode } from '../lib/ontology.ts';
import OntologyTree, { type GroupNode } from '../components/OntologyTree.astro';

// TODO:
// - Replace these with the hrefs to their content pages
const menuItems = ["Writings", "Projects", "About"];

// Writings grouping for the menu: categories → subcategories → series, each
// with a per-group published-article count. In prod only published articles
// are counted/listed; in dev, everything (so fixtures are visible locally).
const entries = await getCollection('writings', ({ data }) =>
  import.meta.env.PROD ? data.published : true,
);
const view = buildOntology(entries);

const toGroup = (node: OntologyNode): GroupNode => ({
  node,
  count: view.count(node.path),
  children: view
    .childrenOf(node.path)
    .filter((c) => view.count(c.path) > 0)
    .map(toGroup),
});

const writingsTree: GroupNode[] = view
  .childrenOf(null)
  .filter((n) => view.count(n.path) > 0)
  .map(toGroup);
---
<!-- Document-level rules must target the <body> rendered by BaseLayout, so
     they can't be scoped to this component. Bundled only on this page. -->
<style is:global>
  :root {
    --panel-gap: 4rem;
  }

  body {
    display: flex;
    align-items: center;
    min-height: 100vh;
  }
</style>

<style>
  .home-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--panel-gap);
    width: 100%;
    font-family: var(--font-mono);
  }

  .home-panel-placeholder {
    display: flex;
    flex-direction: column;
    width: fit-content;
    align-items: center;
  }

  .main-menu {
    display: flex;
    flex-direction: column;
    width: fit-content;
    justify-self: end;

    .main-menu-button {
      display: flex;
      flex-direction: row;
      align-items: baseline;
      white-space: nowrap;
      font-size: calc(100% + 2em);

      .main-menu-button-index {
        font-weight: 100;
        padding-right: 0.3em;
      }

      &:hover {
        .main-menu-button-label {
          text-decoration: underline var(--accent);
          text-decoration-thickness: 1.5px;
          text-underline-offset: 5px;
        }
      }
    }
  }

</style>

<BaseLayout title="ninjack.dev">
  <StatusBar />
  <div class="home-panels">
    <div class="main-menu">
      {menuItems.map((l, i) => {
        return <div class="main-menu-group">
          <div class="main-menu-button">
            <span class="main-menu-button-index">[{i + 1}]</span>
            <span class="main-menu-button-label">{l}</span>
          </div>
          {l === "Writings" && writingsTree.length > 0 && (
            <OntologyTree groups={writingsTree} />
          )}
        </div>
      })}
    </div>
    <div class="home-panel-placeholder">
      <ProfilePic />
      <blockquote style="margin-top: 1em;">Jack of all trades, master of some</blockquote>
      <p>Software engineer based out of Portland, OR.<br>Lover of all things dev tooling.</p>
    </div>
  </div>
</BaseLayout>
