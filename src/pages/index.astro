---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfilePic from "../components/AvatarProfilePic.astro";
import StatusBar from "../components/StatusBar/StatusBar.astro";
import TreeMenu from "../components/TreeMenu.astro";
---

<style is:global>
  :root {
    --panel-gap: 4rem;
  }

  body {
    display: flex;
    align-items: center;
    min-height: 100vh;
  }
</style>

<style>
  .home-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--panel-gap);
    width: 100%;
    font-family: var(--font-mono);
  }

  .home-panel-placeholder {
    display: flex;
    flex-direction: column;
    width: fit-content;
    align-items: center;
  }

  .keyboard-menu {
    display: flex;
    flex-direction: column;
    width: fit-content;
    justify-self: end;
  }
</style>

<BaseLayout title="ninjack.dev">
  <StatusBar />
  <div class="home-panels">
    <div
      class="keyboard-menu"
    >
      <TreeMenu />
    </div>
    <div class="home-panel-placeholder">
      <ProfilePic />
      <blockquote style="margin-top: 1em;">
        Jack of all trades, master of some
      </blockquote>
      <p>
        Software engineer based out of Portland, OR.<br />Lover of all things
        dev tooling.
      </p>
    </div>
  </div>

</BaseLayout>
