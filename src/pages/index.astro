---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfilePic from "../components/AvatarProfilePic.astro";
import StatusBar from "../components/StatusBar/StatusBar.astro";
import TreeMenu from "../components/TreeMenu.astro";
---

<style is:global>
  :root {
    --panel-gap: 4rem;
  }

  body {
    display: flex;
    align-items: center;
    min-height: 100vh;
  }
</style>

<style>
  .home-panels {
    display: flex;
    justify-content: center;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--panel-gap);
    width: 100%;
    font-family: var(--font-mono);
    /* Ensure the panels container is at least viewport tall so the tree
       and placeholder have room to expand downward. */
    min-height: 100vh;
    --tree-column-width: calc(50vw - var(--panel-gap) / 2);
  }



  .home-panel-placeholder {
    display: flex;
    flex-direction: column;
    width: fit-content;
    align-items: center;
  }
</style>

<BaseLayout title="ninjack.dev">
  <StatusBar />
  <div class="home-panels">
    <TreeMenu />
    <div class="home-panel-placeholder">
      <ProfilePic />
      <blockquote style="margin-top: 1em;">
        Jack of all trades, master of some
      </blockquote>
      <p>
        Software engineer based out of Portland, OR.<br />Lover of all things
        dev tooling.
      </p>
    </div>
  </div>
</BaseLayout>
