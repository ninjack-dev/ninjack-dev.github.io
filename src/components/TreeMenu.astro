---
import { getOntology, type OntologyNode } from '../lib/ontology/index.ts';

interface MenuItem {
  label: string;
  href?: string;
  count?: number;
  children: MenuItem[];
}

export interface Props {
  items?: MenuItem[];
  parentPath?: number[];
}

const { items: explicitItems, parentPath = [] } = Astro.props;
const depth = parentPath.length;
const isRoot = depth === 0;

let items: MenuItem[];
if (explicitItems) {
  items = explicitItems;
} else {
  const view = await getOntology();

  function toMenuItem(node: OntologyNode): MenuItem {
    return {
      label: node.name,
      href: `/writings/${node.path}`,
      count: view.count(node.path),
      children: view
        .childrenOf(node.path)
        .filter((c) => view.count(c.path) > 0)
        .map(toMenuItem),
    };
  }

  const writingsItems = view
    .childrenOf(null)
    .filter((n) => view.count(n.path) > 0)
    .map(toMenuItem);

  items = [
    { label: "Writings", href: "/writings", children: writingsItems },
    { label: "Projects", href: "/projects", children: [] },
    { label: "About", href: "/about", children: [] },
  ] as const;
}

// We find the single widest node in the tree and use its
// characteristics to set a fixed width for the container.
// The browser lays out the tree as a maximum of per-node
// right-edge offsets — each node is independently indented from
// the root, and only the widest single node matters for the
// container width.
//
// The width is capped at the column width so the tree never
// overflows the grid layout.
//
// Must stay in sync with the per-depth font-size rules in the CSS
// below and the .children padding/margin indentation values.

/** Font-size multiplier at a given depth (matching the CSS rules below). */
function fontRatioAtDepth(depth: number): number {
  // .depth-0: calc(100% + 2em)  →  3
  // .depth-1: calc(100% + 1.2em) → 2.2
  // .depth-2: calc(100% + 0.6em) → 1.6
  // .depth-3+: calc(100% + 0.2em) → 1.2
  if (depth <= 0) return 3;
  if (depth === 1) return 2.2;
  if (depth === 2) return 1.6;
  return 1.2;
}

/**
 * Walk the menu tree and find the single widest node (label-ch
 * contribution × font ratio + depth indentation), which
 * determines the container width.
 */
function computeWidestNode(tree: MenuItem[]): { labelCh: number; depth: number } {
  let bestLabelCh = 0;
  let bestDepth = 0;

  function walk(nodes: MenuItem[], path: number[]) {
    for (let i = 0; i < nodes.length; i++) {
      const item = nodes[i];
      const currentPath = [...path, i];
      const depth = currentPath.length - 1;
      const fontRatio = fontRatioAtDepth(depth);

      const segs = currentPath.map((n) => n + 1);
      const sigil = `[${segs.join(".")}]`;
      const countStr =
        item.count != null && item.count > 0 ? `(${item.count})` : "";
      const parts = [sigil, item.label];
      if (countStr) parts.push(countStr);
      const displayStr = parts.join(" ");

      const labelCh = displayStr.length * fontRatio;

      // 1.4em per depth ≈ (1.4 / 0.6) ch for comparison purposes
      const emToChRatio = 1.4 / 0.6;
      const estimatedCh = labelCh + depth * emToChRatio;
      const bestEstimatedCh = bestLabelCh + bestDepth * emToChRatio;

      if (estimatedCh > bestEstimatedCh) {
        bestLabelCh = labelCh;
        bestDepth = depth;
      }

      if (item.children.length > 0) {
        walk(item.children, currentPath);
      }
    }
  }

  walk(tree, []);
  return { labelCh: Math.ceil(bestLabelCh), depth: bestDepth };
}

const { labelCh, depth: widestDepth } = computeWidestNode(items);

---

{isRoot ? (
  <div
    class="tree-menu-root"
    style={`--tree-widest-label-ch: ${labelCh}; --tree-widest-depth: ${widestDepth};`}
  >
    {items.map((item, i) => {
      const path = [...parentPath, i];
      const pathStr = path.join(',');
      const segs = path.map((n) => n + 1);
      const sigil = segs.join('.');

      return (
        <div class={`menu-item depth-${depth}`} data-path={pathStr}>
          <div class="menu-item-label">
            <span class="sigil">[{segs.slice(0, -1).join('.')}{segs.length > 1 ? '.' : ''}<span class="sigil-segment-last">{segs.at(-1)}</span>]</span>
            {item.href
              ? <a href={item.href} class="label">{item.label}</a>
              : <span class="label">{item.label}</span>}
            {item.count != null && item.count > 0 &&
              <span class="count">({item.count})</span>}
          </div>
          {item.children.length > 0 &&
            <div class="children-wrap">
              <div class="children">
                <Astro.self items={item.children} parentPath={path} />
              </div>
            </div>}
        </div>
      );
    })}
  </div>
) : items.map((item, i) => {
  const path = [...parentPath, i];
  const pathStr = path.join(',');
  const segs = path.map((n) => n + 1);
  const sigil = segs.join('.');

  return (
    <div class={`menu-item depth-${depth}`} data-path={pathStr}>
      <div class="menu-item-label">
        <span class="sigil">[{segs.slice(0, -1).join('.')}{segs.length > 1 ? '.' : ''}<span class="sigil-segment-last">{segs.at(-1)}</span>]</span>
        {item.href
          ? <a href={item.href} class="label">{item.label}</a>
          : <span class="label">{item.label}</span>}
        {item.count != null && item.count > 0 &&
          <span class="count">({item.count})</span>}
      </div>
      {item.children.length > 0 &&
        <div class="children-wrap">
          <div class="children">
            <Astro.self items={item.children} parentPath={path} />
          </div>
        </div>}
    </div>
  );
})}

<!--
  Global styles for the tree-menu widget.
  These are global because:
    • The JS runtime manipulates classes (.selected, .open) on elements
      across recursive component instances, and Astro's scoped selectors won't
      cross component boundaries correctly in a recursive tree.
    • The widget is page-specific (only used on the index page), so global
      style leakage is not a concern.
-->
<style is:global>
  .menu-item {
    display: flex;
    flex-direction: column;
  }

  .menu-item-label {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    overflow-wrap: break-word;
    transition: color 100ms ease;
    cursor: default;
  }

  /* Font-size steps by depth — depth-0 is the "root" level.
     The cqi multiplier is chosen so that cqi equals the step
     at the precomputed width (~500px), so the step wins at
     full width and cqi wins when the column shrinks. */
  .menu-item.depth-0 > .menu-item-label {
    font-size: min(10cqi, calc(100% + 2em));
  }
  .menu-item.depth-1 > .menu-item-label {
    font-size: min(7.5cqi, calc(100% + 1.2em));
  }
  .menu-item.depth-2 > .menu-item-label {
    font-size: min(5.5cqi, calc(100% + 0.6em));
  }
  .menu-item.depth-3 > .menu-item-label,
  .menu-item.depth-4 > .menu-item-label,
  .menu-item.depth-5 > .menu-item-label {
    font-size: min(4.5cqi, calc(100% + 0.2em));
  }

  .sigil {
    font-weight: 100;
    padding-right: 0.3em;
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .menu-item.selected > .menu-item-label .sigil-segment-last {
    color: var(--accent);
  }

  .label {
    color: var(--text);
    text-decoration: none;
  }
  .menu-item.selected > .menu-item-label .label {
    text-decoration: underline var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .menu-item-label:hover .label {
    text-decoration: underline var(--accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }

  .count {
    opacity: 0.6;
    margin-left: 0.35em;
    font-size: 0.6em;
  }

  .children-wrap {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 350ms ease;
  }

  .children-wrap.open {
    grid-template-rows: 1fr;
  }

  .tree-menu-root {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    container-type: inline-size;
    width: min(
      calc(var(--tree-widest-label-ch) * 1ch + var(--tree-widest-depth) * 1.4em),
      100%
    );
  }

  .children {
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding-left: 0.6em;
    border-left: 1px solid var(--border);
    margin-left: calc(0.6em + 0.2em);
    margin-top: 0.15em;
  }
</style>

<script>
  const el = document.querySelector(".tree-menu-root");
  if (!el) throw new Error("TreeMenu root not found");

  const container: HTMLElement = el;

  /** Current selection path (indices into each level). */
  let path: number[] = [];

  /** Get the DOM element at a given path. */
  function elAtPath(p: number[]): HTMLElement | null {
    const pathStr = p.join(",");
    return container.querySelector(`.menu-item[data-path="${pathStr}"]`);
  }

  /** Check if the element at a given path has children (a .children-wrap). */
  function hasChildren(itemPath: number[]): boolean {
    const el = elAtPath(itemPath);
    return el !== null && el.querySelector(".children-wrap") !== null;
  }

  /** Get the href of the element at a given path (if it has a link). */
  function hrefAtPath(itemPath: number[]): string | null {
    const el = elAtPath(itemPath);
    if (!el) return null;
    const a = el.querySelector<HTMLAnchorElement>(".menu-item-label a");
    return a ? a.getAttribute("href") : null;
  }

  /** Count sibling items at a given level. */
  function countAtLevel(level: number): number {
    const prefix = path.slice(0, level);
    let count = 0;
    for (const item of container.querySelectorAll<HTMLElement>(".menu-item")) {
      const raw = item.getAttribute("data-path");
      if (!raw) continue;
      const segments = raw.split(",").map(Number);
      if (segments.length !== level + 1) continue;
      let match = true;
      for (let i = 0; i < level; i++) {
        if (segments[i] !== prefix[i]) {
          match = false;
          break;
        }
      }
      if (match) count++;
    }
    return count;
  }

  /**
   * The **frontier** is the deepest level that has unselected children
   * available below `path`.
   *
   * - Empty path → frontier = 0 (root items).
   * - If the deepest selected node has children → frontier = path.length
   *   (the children level).
   * - If the deepest selected node is a leaf → frontier = path.length - 1
   *   (replace at leaf level).
   */
  function findFrontier(): number {
    if (path.length === 0) return 0;
    if (hasChildren(path)) return path.length;
    return path.length - 1;
  }

  function isSelected(itemPath: number[]): boolean {
    if (itemPath.length !== path.length) return false;
    return itemPath.every((p, i) => p === path[i]);
  }

  function isAncestor(itemPath: number[]): boolean {
    if (itemPath.length >= path.length) return false;
    return itemPath.every((p, i) => p === path[i]);
  }

  function shouldOpenChildren(itemPath: number[]): boolean {
    if (isAncestor(itemPath)) return true;
    if (isSelected(itemPath)) {
      return hasChildren(itemPath);
    }
    return false;
  }

  /**
   * Reconcile the DOM with the current `path`.
   *
   * Toggles `.selected` on each item and `.open` on each
   * children-wrap — CSS handles the reveal/clip animation via
   * `grid-template-rows` transition.
   */
  function updateDOM(): void {
    const items = container.querySelectorAll<HTMLElement>(".menu-item");
    for (const el of items) {
      const raw = el.getAttribute("data-path");
      if (!raw) continue;
      const itemPath = raw.split(",").map(Number);

      el.classList.toggle("selected", isSelected(itemPath));

      const wrap = el.querySelector<HTMLElement>(".children-wrap");
      if (wrap) {
        wrap.classList.toggle("open", shouldOpenChildren(itemPath));
      }
    }
  }

  function handleNumber(n: number): void {
    const frontier = findFrontier();
    if (frontier < 0) return;
    const count = countAtLevel(frontier);
    if (n - 1 >= count) return;

    path = path.slice(0, frontier);
    path.push(n - 1);
    updateDOM();
  }

  function moveSibling(delta: number): void {
    if (path.length === 0) return;
    const level = path.length - 1;
    const count = countAtLevel(level);
    const cur = path[level];
    const next = Math.max(0, Math.min(count - 1, cur + delta));
    if (next !== cur) {
      path[level] = next;
      updateDOM();
    }
  }

  function drillIn(): void {
    if (path.length === 0) return;
    const href = hrefAtPath(path);
    if (href) {
      window.location.href = href;
      return;
    }
    if (hasChildren(path)) {
      path.push(0);
      updateDOM();
    }
  }

  function popLevel(): void {
    if (path.length > 0) {
      path.pop();
      updateDOM();
    }
  }

  function clearSelection(): void {
    path = [];
    updateDOM();
  }

  function handleKey(e: KeyboardEvent): void {
    if (e.repeat) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;

    const el = document.activeElement;
    if (
      el &&
      (el.tagName === "INPUT" ||
        el.tagName === "TEXTAREA" ||
        (el instanceof HTMLElement && el.isContentEditable))
    ) {
      return;
    }

    const key = e.key;

    if (key >= "1" && key <= "9") {
      e.preventDefault();
      handleNumber(parseInt(key, 10));
    } else if (key === "j") {
      e.preventDefault();
      moveSibling(1);
    } else if (key === "k") {
      e.preventDefault();
      moveSibling(-1);
    } else if (key === "l" || key === "Enter") {
      e.preventDefault();
      drillIn();
    } else if (key === "h" || key === "Backspace") {
      e.preventDefault();
      popLevel();
    } else if (key === "Escape") {
      e.preventDefault();
      clearSelection();
    }
  }

  document.addEventListener("keydown", handleKey);
  updateDOM();
</script>
