---
import Uptime from "./Uptime.astro";
import CommitHash from "./CommitHash.astro";
---

<style>
  .status-bar {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 10;

    display: flex;
    align-items: center;
    gap: 0.75em;

    padding: 0.4em 0.8em;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
</style>

<span class="status-bar">
  <span>Built</span><Uptime /><span>ago at</span><CommitHash />
</span>
