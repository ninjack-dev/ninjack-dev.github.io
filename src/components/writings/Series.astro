---
import { getEntry, render } from "astro:content";
import type { OntologyView } from "../../lib/ontology/index.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  nodeId: string;
  view: OntologyView;
}

const { nodeId, view } = Astro.props;
const node = view.nodes.get(nodeId)!;
const description = await getEntry("writings", nodeId);
const Content = description ? (await render(description)).Content : null;
const articles = view.articlesOf(nodeId);
const title = description?.data.title ?? node.name;
---

<BaseLayout title={title} description={description?.data.description}>
  <main class="prose">
    <h1>{title}</h1>
    {Content && <Content />}
    <h2>Articles</h2>
    <ul>
      {articles.map((entry) => (
        <li>
          <a href={`/writings/${entry.id}`}>
            {entry.data.title ?? entry.id.split("/").at(-1)}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
