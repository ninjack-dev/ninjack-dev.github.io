---
import { Image } from 'astro:assets';
import profileAvatar from '../assets/avatar.png';
import profileReal from '../assets/profile.png';
---

<style is:global>
  @property --mask-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @property --line-pos {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 0%;
  }

  :root {
    --profile-ease-curve: cubic-bezier(0.33, 1, 0.68, 1) /* easeOutCubic */;
    --profile-enter-duration: 350ms;
    --profile-leave-duration: 350ms;
    --profile-lock-duration: 350ms;
    --profile-lock-ease-curve: cubic-bezier(0.32, 0, 0.67, 0) /* easeInCubic */;
  }
</style>

<style>
  .profile-container {
    position: relative;
    width: 15rem;
    height: 15rem;
    border-radius: 50%;
    overflow: hidden;
    cursor: crosshair;
    flex-shrink: 0;
    contain: layout style paint;
    transform: translateZ(0);

    img {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .profile-avatar {
    z-index: 1;

    &.entering, &.leaving {
      mask-image: linear-gradient(
        calc(var(--mask-angle) - 90deg),
        transparent 0% var(--line-pos),
        black var(--line-pos) 100%
      );
    }

    &.entering {
      transition: --line-pos var(--profile-enter-duration) var(--profile-ease-curve);
    }

    &.leaving {
      transition: --line-pos var(--profile-leave-duration) var(--profile-ease-curve);
    }

    &.tracking {
      mask-image: conic-gradient(
        from var(--mask-angle) at 50% 50%,
        transparent 0deg 180deg,
        black 180deg 360deg
      );
    }

    &.committing {
      mask-image: linear-gradient(
        calc(var(--mask-angle) - 90deg),
        transparent 0% var(--line-pos),
        black var(--line-pos) 100%
      );
      transition: --line-pos var(--profile-lock-duration) var(--profile-lock-ease-curve);
    }

    &.committed {
      mask-image: linear-gradient(
        calc(var(--mask-angle) - 90deg),
        transparent 0% var(--line-pos),
        black var(--line-pos) 100%
      );
    }
  }
</style>

<div class="profile-container">
  <Image class="profile-real" src={profileReal} alt="" loading="eager" />
  <Image class="profile-avatar" src={profileAvatar} alt="" loading="eager" />
</div>

<script>
  // Keep in sync with --profile-enter-duration.
  const ENTER_MS = 350;
  // Keep in sync with --profile-lock-duration.
  const LOCK_MS = 350;

  document.querySelectorAll<HTMLElement>('.profile-container').forEach((container) => {
    const avatar = container.querySelector<HTMLElement>('.profile-avatar')!;
    let enterToken = 0;
    type AnimState = 'idle' | 'entering' | 'tracking' | 'committing' | 'locked';
    let animState: AnimState = 'idle';
    let isLocked = false;
    let pendingCommit = false;
    let isHovering = false;

    let cachedRect: DOMRect | null = null;
    function invalidateRect() { cachedRect = null; }
    window.addEventListener('resize', invalidateRect);
    window.addEventListener('scroll', invalidateRect, { passive: true });

    function getAngle(clientX: number, clientY: number): number {
      if (!cachedRect) {
        cachedRect = container.getBoundingClientRect();
      }
      return Math.atan2(
        clientY - (cachedRect.top + cachedRect.height / 2),
        clientX - (cachedRect.left + cachedRect.width / 2),
      ) * (180 / Math.PI);
    }

    function commit(): void {
      const token = ++enterToken;
      animState = 'committing';
      avatar.classList.remove('entering', 'tracking', 'committed');
      void avatar.offsetWidth;
      avatar.classList.add('committing');
      avatar.style.setProperty('--line-pos', isLocked ? '0%' : '100%');

      setTimeout(() => {
        if (enterToken !== token) return;
        isLocked = !isLocked;
        avatar.classList.remove('committing');
        avatar.classList.add('committed');
        animState = isHovering ? 'tracking' : (isLocked ? 'locked' : 'idle');
      }, LOCK_MS);
    }

    function enter(clientX: number, clientY: number): void {
      const token = ++enterToken;
      animState = 'entering';
      avatar.style.setProperty('--mask-angle', `${getAngle(clientX, clientY)}deg`);
      avatar.classList.remove('leaving', 'tracking', 'committing', 'committed');
      void avatar.offsetWidth;
      avatar.classList.add('entering');
      avatar.style.setProperty('--line-pos', '50%');

      setTimeout(() => {
        if (enterToken !== token) return;
        if (pendingCommit) {
          pendingCommit = false;
          commit();
        } else {
          animState = 'tracking';
          avatar.classList.remove('entering');
          avatar.classList.add('tracking');
        }
      }, ENTER_MS);
    }

    let pendingMove: { clientX: number; clientY: number } | null = null;
    let moveRafScheduled = false;

    function flushMove(): void {
      moveRafScheduled = false;
      if (!pendingMove) return;
      const { clientX, clientY } = pendingMove;
      pendingMove = null;
      // Mask isn't visible in these states — no point updating.
      if (animState === 'idle' || animState === 'locked') return;
      avatar.style.setProperty('--mask-angle', `${getAngle(clientX, clientY)}deg`);
    }

    function scheduleMove(clientX: number, clientY: number): void {
      pendingMove = { clientX, clientY };
      if (!moveRafScheduled) {
        moveRafScheduled = true;
        requestAnimationFrame(flushMove);
      }
    }

    function leave(clientX: number, clientY: number): void {
      if (animState === 'committing') return;
      ++enterToken;
      pendingCommit = false;
      animState = isLocked ? 'locked' : 'idle';
      avatar.style.setProperty('--mask-angle', `${getAngle(clientX, clientY)}deg`);
      avatar.classList.remove('entering', 'tracking', 'committed');
      void avatar.offsetWidth;
      avatar.classList.add('leaving');
      avatar.style.setProperty('--line-pos', isLocked ? '100%' : '0%');
    }

    container.addEventListener('mouseenter', (e: MouseEvent) => { isHovering = true;  enter(e.clientX, e.clientY); });
    container.addEventListener('mousemove',  (e: MouseEvent) => scheduleMove(e.clientX, e.clientY));
    container.addEventListener('mouseleave', (e: MouseEvent) => { isHovering = false; leave(e.clientX, e.clientY); });

    container.addEventListener('click', () => {
      if (animState === 'entering') pendingCommit = true;
      else if (animState === 'tracking') commit();
    });

    container.addEventListener('touchstart', (e: TouchEvent) => {
      isHovering = true;
      const t = e.touches[0];
      enter(t.clientX, t.clientY);
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      e.preventDefault();
      const t = e.touches[0];
      scheduleMove(t.clientX, t.clientY);
    }, { passive: false });

    container.addEventListener('touchend', (e: TouchEvent) => {
      isHovering = false;
      const t = e.changedTouches[0];
      if (animState === 'entering') {
        pendingCommit = true;
      } else {
        leave(t.clientX, t.clientY);
      }
    });

    container.addEventListener('touchcancel', (e: TouchEvent) => {
      isHovering = false;
      const t = e.changedTouches[0];
      leave(t.clientX, t.clientY);
    });
  });
</script>
