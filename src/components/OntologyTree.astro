---
import type { OntologyNode } from "../lib/ontology/index.ts";

export interface GroupNode {
  node: OntologyNode;
  count: number;
  children: GroupNode[];
}

interface Props {
  groups: GroupNode[];
}

const { groups } = Astro.props;
---

<ul class="ontology-tree">
  {
    groups.map((g) => (
      <li>
        <a href={`/writings/${g.node.path}`}>{g.node.name}</a>
        <span class="ontology-count">({g.count})</span>
        {g.children.length > 0 && <Astro.self groups={g.children} />}
      </li>
    ))
  }
</ul>

<style>
  .ontology-tree {
    list-style: none;
    padding-left: 1em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .ontology-count {
    opacity: 0.6;
    margin-left: 0.35em;
  }
</style>
